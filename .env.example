# Copy to .env and fill in your keys.
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
TAVILY_API_KEY=tvly-...

PINECONE_INDEX=igcse-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI models (reasoning effort: none | minimal | low | medium | high)
EXTRACTION_MODEL=gpt-5.5
CHAT_MODEL=gpt-5.5
CLASSIFIER_MODEL=gpt-5.4-mini
EXTRACTION_EFFORT=medium
CHAT_EFFORT=low

# Tuning
RELEVANCE_THRESHOLD=0.35
DEDUP_SIMILARITY=0.92
PAPER_DIVERSITY_SIMILARITY=0.85
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP=40
MAX_CONCURRENCY=5

# --- Deployment (Railway) -------------------------------------------------
# Where data/, output/ and logs/ are stored. The Docker image sets /storage (mount a volume there).
# STORAGE_DIR=/storage

# Access control: either a shared password ...
# APP_PASSWORD=choose-a-strong-password
# ... or sign-in with Google/Microsoft (see doc/deploy_railway.md)
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_COOKIE_SECRET=
# AUTH_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# ALLOWED_EMAIL_DOMAINS=yourschool.edu
# ALLOWED_EMAILS=alice@example.com,bob@example.com
